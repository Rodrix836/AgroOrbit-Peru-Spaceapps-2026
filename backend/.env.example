APP_NAME=AgroOrbit Perú API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_COMMUNITY=AG
NASA_POWER_TIMEOUT=30

# Identidad: valores del proyecto Supabase; el token llega en Authorization.
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_PUBLISHABLE_KEY=[PUBLISHABLE_KEY]

# Copia la cadena PostgreSQL desde Supabase > Connect. Nunca subas la contraseña.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require
